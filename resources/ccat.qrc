<!DOCTYPE RCC>
<RCC version="1.0">
    <!-- 트레이 아이콘 (py_codes/make_tray_icon.py 로 생성) -->
    <qresource prefix="/icons">
        <file alias="tray_face_16.png">../assets/tray_face_16.png</file>
        <file alias="tray_face_24.png">../assets/tray_face_24.png</file>
        <file alias="tray_face_32.png">../assets/tray_face_32.png</file>
        <file alias="tray_face_48.png">../assets/tray_face_48.png</file>
        <file alias="tray_face_64.png">../assets/tray_face_64.png</file>
        <!-- 강아지 얼굴 (py_codes/make_dog_assets.py 로 생성). 팝업 얼굴 메뉴 / 동물을 바꿨을 때 트레이 -->
        <file alias="white_dog_face_16.png">../assets/white_dog_face_16.png</file>
        <file alias="white_dog_face_24.png">../assets/white_dog_face_24.png</file>
        <file alias="white_dog_face_32.png">../assets/white_dog_face_32.png</file>
        <file alias="white_dog_face_48.png">../assets/white_dog_face_48.png</file>
        <file alias="white_dog_face_64.png">../assets/white_dog_face_64.png</file>
        <file alias="brown_dog_face_16.png">../assets/brown_dog_face_16.png</file>
        <file alias="brown_dog_face_24.png">../assets/brown_dog_face_24.png</file>
        <file alias="brown_dog_face_32.png">../assets/brown_dog_face_32.png</file>
        <file alias="brown_dog_face_48.png">../assets/brown_dog_face_48.png</file>
        <file alias="brown_dog_face_64.png">../assets/brown_dog_face_64.png</file>
    </qresource>
    <!-- 고양이 울음소리 (CatVoice). 16-bit PCM, py_codes/convert_meow.py 로 meow-sound/ 에서 변환 -->
    <qresource prefix="/sounds">
        <file alias="meow1.wav">../assets/sounds/meow1.wav</file>
        <file alias="meow2.wav">../assets/sounds/meow2.wav</file>
        <file alias="meow3.wav">../assets/sounds/meow3.wav</file>
        <file alias="meow4.wav">../assets/sounds/meow4.wav</file>
        <!-- 잡히는 순간 (CatVoice::grabCry). 원본 meow-sound/mmeow1.mp3 (CC0) -->
        <file alias="grab1.wav">../assets/sounds/mmeow1.wav</file>
    </qresource>
</RCC>
